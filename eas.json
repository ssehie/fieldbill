{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "internal": {
      "distribution": "internal",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      }
    },
    "release-apk": {
      "distribution": "internal",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "developmentClient": false,
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6762166246"
      }
    }
  }
}
