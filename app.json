{
  "expo": {
    "name": "FieldBill",
    "slug": "fieldbill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldbill",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "6",
      "bundleIdentifier": "com.fieldbill.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "FieldBill uses the microphone only when you choose to record an optional talk note for an active job, such as a quick reminder about parts used or work still needed. Audio notes are saved with that job on your device."
      }
    },
    "android": {
      "versionCode": 10,
      "package": "com.fieldbill.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F1E7"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow FieldBill to add jobs and follow-ups to your calendar.",
          "remindersPermission": "Allow FieldBill to create reminders for scheduled work."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FieldBill to use your location so job addresses can be filled in faster."
        }
      ],
      "expo-sqlite",
      "expo-mail-composer",
      "expo-audio",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "638a8a6e-1f34-4152-bfad-8268bacb3bd9"
      }
    },
    "owner": "ssehie"
  }
}
